model Task {
  id          String  @id @default(uuid())
  title       String
  description String?
  position    Int

  columnId String
  column   BoardColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([columnId, position])
  @@map("tasks")
}
